  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-06.jpeg",
   "text": "First, take up space. Stop folding into yourself."
  },
  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-07.jpeg",
   "text": "Shoulders back, chin slightly up, and stand still."
