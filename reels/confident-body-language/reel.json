  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-08.jpeg",
   "text": "Still bodies look calm."
  },
  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-09.jpeg",
   "text": "Fidgety bodies look nervous."
  },
  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-10.jpeg",
   "text": "Second, slow everything down."
  },
  {
   "image": "C:/Users/Anojan/flow-mcp-out/confident-body-language/scene-11.jpeg",
